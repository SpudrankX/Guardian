--- guardian_manager.py.old
+++ guardian_manager.py
@@ -15,6 +15,33 @@
 import time, json, datetime
 from flask import Flask
+import subprocess, psutil, threading
+
+# === Auto-restart Monitor ===
+def is_process_running(name):
+    for proc in psutil.process_iter(['pid', 'name', 'cmdline']):
+        try:
+            if name in " ".join(proc.info['cmdline']):
+                return True
+        except (psutil.NoSuchProcess, psutil.AccessDenied, psutil.ZombieProcess):
+            pass
+    return False
+
+def restart_process(cmd, tag):
+    try:
+        subprocess.Popen(cmd, shell=True)
+        print(f"[{datetime.datetime.now()}] [{tag}] restarted successfully.")
+    except Exception as e:
+        print(f"[{datetime.datetime.now()}] [{tag}] restart failed: {e}")
+
+def monitor_services():
+    while True:
+        if not is_process_running('heartbeat.py'):
+            restart_process('~/heartbeat-start', 'HEARTBEAT')
+        if not is_process_running('watcher'):
+            restart_process('~/watcher-start', 'WATCHER')
+        time.sleep(10)
+
+threading.Thread(target=monitor_services, daemon=True).start()
